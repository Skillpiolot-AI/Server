# Test Environment Configuration
NODE_ENV=test
PORT=3001

# Database - MongoDB Memory Server is used for tests
MONGODB_URI=memory

# JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-ci-testing
JWT_EXPIRES_IN=7d

# Frontend URL for email links
FRONTEND_URL=http://localhost:5173

# Email Configuration (mocked in tests)
EMAIL_HOST=smtp.test.com
EMAIL_PORT=587
EMAIL_USER=test@test.com
EMAIL_PASS=test-password
EMAIL_FROM=noreply@skillpilot.test

# Company Info
COMPANY_NAME=Skill-Pilot-Test

# Timezone
TZ=Asia/Kolkata

# Google OAuth (mocked in tests)
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret

# Rate Limiting (disabled for tests)
RATE_LIMIT_ENABLED=false

# Logging (minimal for tests)
LOG_LEVEL=error
